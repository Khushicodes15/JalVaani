# JalVaani AI — environment configuration
# Copy to .env and edit. Never commit .env to git.

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Development: include Vite dev server.
# Production: set to your actual domain only.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=120

# ── Static UI ─────────────────────────────────────────────────────────────────
# Path to the built React app (relative to jalvaani_api/).
# After running `cd jalvaani_ui && npm run build`:
STATIC_DIR=../jalvaani_ui/dist

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Cache TTLs ────────────────────────────────────────────────────────────────
CACHE_TTL_NATIONAL_STATS=3600
CACHE_TTL_STATIONS_PAGE=300
